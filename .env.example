# --- Database (required) ---
# MongoDB Atlas connection string. See README "MongoDB Atlas setup" for how
# to generate this. Must include a database name before the query string,
# e.g. .../instaphysique?retryWrites=true...
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/instaphysique?retryWrites=true&w=majority

# --- Admin endpoint (required to use GET /api/leads) ---
# Any long random string. Generate one with: openssl rand -hex 32
ADMIN_API_KEY=

# --- Confirmation email (optional) ---
# Leave both blank to skip sending confirmation emails entirely — the lead
# route still works and saves to the database without them.
RESEND_API_KEY=
LEAD_EMAIL_FROM=InstaPhysique Roseville <hello@yourdomain.com>
